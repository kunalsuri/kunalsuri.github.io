---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Search" description="Search the writing.">
  <section class="py-8">
    <p class="eyebrow">Search</p>
    <h1 class="display mt-4 text-4xl sm:text-5xl">Find a post</h1>
    <p class="mt-3 font-body text-muted">
      Full-text search across every post. (Built at deploy time — it works on
      the live site, not in local <code class="font-mono text-sm">dev</code>.)
    </p>

    <div id="search" class="mt-8">
      <pagefind-searchbox placeholder="Search posts…" show-sub-results="true"></pagefind-searchbox>
    </div>
  </section>

  {/* Pagefind's Component UI + index are generated into /pagefind/ by the deploy step. */}
  <link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />
  <script is:inline src="/pagefind/pagefind-component-ui.js" type="module"></script>

  <style>
    /* Theme Pagefind's Component UI to match the site. */
    #search {
      --pf-text: var(--ink);
      --pf-background: var(--paper);
      --pf-border: var(--line);
      --pf-font: var(--font-display);
      --pf-border-radius: 0.7rem;
      --pf-searchbox-max-width: 100%;
      --pf-outline-focus: var(--accent);
    }
  </style>
</BaseLayout>
