---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getTags, getPostsByTag } from '../../utils/taxonomy';
import { readingTime } from '../../utils/reading-time';

export async function getStaticPaths() {
  const tags = await getTags();
  return Promise.all(
    tags.map(async (t) => ({
      params: { tag: t.slug },
      props: { name: t.name, posts: await getPostsByTag(t.slug) },
    })),
  );
}

const { name, posts } = Astro.props;
---

<BaseLayout title={`#${name}`} description={`Posts tagged ${name}.`}>
  <section class="py-8">
    <p class="eyebrow">
      <a href="/tags" class="transition-colors hover:text-accent">Tags</a> / {name}
    </p>
    <h1 class="display mt-4 text-4xl sm:text-5xl">#{name}</h1>
    <p class="mt-3 font-mono text-xs uppercase tracking-wider text-muted">
      {posts.length} post{posts.length === 1 ? '' : 's'}
    </p>

    <div class="mt-8">
      {
        posts.map((post) => (
          <PostCard
            url={`/blog/${post.id}/`}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            category={post.data.category}
            tags={post.data.tags}
            readingTime={readingTime(post.body ?? '')}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
