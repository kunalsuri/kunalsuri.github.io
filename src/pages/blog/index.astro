---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts } from '../../utils/posts';
import { readingTime } from '../../utils/reading-time';

const posts = await getPublishedPosts();
---

<BaseLayout title="Writing" description="Everything I've written, newest first.">
  <section class="py-8">
    <p class="eyebrow">Writing</p>
    <h1 class="display mt-4 text-4xl sm:text-5xl">All posts</h1>
    <p class="mt-3 font-body text-muted">
      {posts.length} post{posts.length === 1 ? '' : 's'}, newest first. Browse by
      <a href="/tags" class="underline decoration-accent underline-offset-2 hover:text-accent">tag</a>,
      <a href="/categories" class="underline decoration-accent underline-offset-2 hover:text-accent">section</a>,
      <a href="/series" class="underline decoration-accent underline-offset-2 hover:text-accent">series</a>, or
      <a href="/archive" class="underline decoration-accent underline-offset-2 hover:text-accent">year</a>.
    </p>

    <div class="mt-8">
      {
        posts.map((post) => (
          <PostCard
            url={`/blog/${post.id}/`}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            category={post.data.category}
            tags={post.data.tags}
            readingTime={readingTime(post.body ?? '')}
            series={post.data.series}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
