---
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getPublishedPosts, type Post } from '../utils/posts';

const posts = await getPublishedPosts();

// Group posts by year (posts already arrive newest-first).
const byYear = new Map<number, Post[]>();
for (const post of posts) {
  const year = post.data.pubDate.getFullYear();
  byYear.set(year, [...(byYear.get(year) ?? []), post]);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<BaseLayout title="Archive" description="Every post, by year.">
  <section class="py-8">
    <p class="eyebrow">Archive</p>
    <h1 class="display mt-4 text-4xl sm:text-5xl">Everything</h1>
    <p class="mt-3 font-body text-muted">
      {posts.length} post{posts.length === 1 ? '' : 's'}, by year.
    </p>

    <div class="mt-10 space-y-10">
      {
        years.map((year) => (
          <div>
            <div class="flex items-center gap-4">
              <h2 class="font-display text-2xl font-extrabold">{year}</h2>
              <hr class="rule flex-1" />
              <span class="font-mono text-xs text-muted">{byYear.get(year)!.length}</span>
            </div>
            <ul class="mt-3">
              {byYear.get(year)!.map((post) => (
                <li class="row-link border-b border-line last:border-0">
                  <a href={`/blog/${post.id}/`} class="flex items-baseline justify-between gap-4 py-3">
                    <span class="row-title font-display font-semibold">{post.data.title}</span>
                    <span class="eyebrow shrink-0">
                      <FormattedDate date={post.data.pubDate} />
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
