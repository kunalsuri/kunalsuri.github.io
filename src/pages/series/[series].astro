---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getAllSeries, getPostsBySeries } from '../../utils/series';
import { readingTime } from '../../utils/reading-time';
import { SERIES_META } from '../../consts';

export async function getStaticPaths() {
  const series = await getAllSeries();
  return Promise.all(
    series.map(async (s) => ({
      params: { series: s.slug },
      props: { summary: s, posts: await getPostsBySeries(s.slug) },
    })),
  );
}

const { summary, posts } = Astro.props;
const meta = SERIES_META[summary.slug];
---

<BaseLayout
  title={summary.name}
  description={summary.description ?? `The ${summary.name} series.`}
>
  <section class="py-8">
    <p class="eyebrow">
      <a href="/series" class="transition-colors hover:text-accent">Series</a> / {summary.name}
    </p>
    <h1 class="display mt-4 text-4xl sm:text-5xl">{summary.name}</h1>

    {summary.description && (
      <p class="mt-4 max-w-2xl font-body text-xl leading-snug text-muted">
        {summary.description}
      </p>
    )}
    {meta?.promise && <p class="mt-3 max-w-2xl font-body text-muted">{meta.promise}</p>}

    <p class="mt-4 font-mono text-xs uppercase tracking-wider text-muted">
      {posts.length} post{posts.length === 1 ? '' : 's'} &middot; in reading order
    </p>

    <!--
      Numbered, oldest-first: a series is meant to be read from the top, which
      is the one place on this site where newest-first would be wrong.
    -->
    <ol class="mt-10">
      {
        posts.map((post, index) => (
          <li class="row-link flex gap-4 border-b border-line py-6 last:border-0 sm:gap-6">
            <span
              class="shrink-0 font-mono text-sm text-muted sm:text-base"
              aria-hidden="true"
            >
              {String(index + 1).padStart(2, '0')}
            </span>
            <a href={`/blog/${post.id}/`} class="block flex-1">
              <div class="eyebrow flex flex-wrap items-center gap-x-3 gap-y-1">
                <FormattedDate date={post.data.pubDate} />
                <span aria-hidden="true">&middot;</span>
                <span>{post.data.category}</span>
                <span aria-hidden="true">&middot;</span>
                <span>{readingTime(post.body ?? '')}</span>
              </div>
              <h2 class="row-title mt-2 font-display text-xl font-bold tracking-tight sm:text-2xl">
                {post.data.title}
              </h2>
              <p class="mt-1.5 font-body text-muted">{post.data.description}</p>
            </a>
          </li>
        ))
      }
    </ol>

    <div class="mt-10 flex items-center justify-between border-t border-line pt-6">
      <a href="/series" class="font-mono text-sm text-accent transition-colors hover:text-ink">
        &larr; All series
      </a>
      <a href="/rss.xml" class="font-mono text-xs text-muted transition-colors hover:text-accent">
        RSS Feed
      </a>
    </div>
  </section>
</BaseLayout>
