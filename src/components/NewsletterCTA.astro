---
import { NEWSLETTER } from '../consts';
---

<div class="my-12 rounded-2xl border border-line bg-surface/60 p-6 md:p-8 backdrop-blur-sm transition-all shadow-sm" data-pagefind-ignore>
  <div class="flex flex-col gap-6">
    {/* Header */}
    <div class="max-w-2xl">
      <div class="eyebrow flex items-center gap-2 text-xs font-bold text-accent uppercase tracking-wider mb-2">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-accent"></span>
        </span>
        <span>Updates &amp; Feed</span>
      </div>
      <h3 class="font-display text-xl md:text-2xl font-bold text-ink">{NEWSLETTER.title}</h3>
      <p class="mt-1.5 text-sm text-muted leading-relaxed font-body">
        {NEWSLETTER.description}
      </p>
    </div>

    {/* Platform Action Cards */}
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {/* Substack Card */}
      <a
        href={NEWSLETTER.substackUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group relative flex flex-col justify-between rounded-xl border border-line bg-canvas p-4 transition-all duration-200 hover:-translate-y-0.5 hover:border-accent hover:shadow-md"
      >
        <div>
          <div class="flex items-center justify-between mb-2">
            <span class="inline-flex items-center gap-1.5 rounded-md bg-accent/10 px-2 py-0.5 font-mono text-[10px] font-semibold text-accent uppercase tracking-wider">
              Newsletter
            </span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-muted transition-transform group-hover:translate-x-0.5 group-hover:text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </div>
          <div class="flex items-center gap-2.5 mt-1">
            {/* Substack Logo SVG — kept monochrome to match the site's restrained mark treatment. */}
            <svg class="h-5 w-5 fill-muted shrink-0 transition-colors group-hover:fill-accent" viewBox="0 0 24 24" role="img" aria-label="Substack">
              <path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/>
            </svg>
            <span class="font-display font-bold text-ink group-hover:text-accent transition-colors">
              Substack
            </span>
          </div>
          <p class="mt-1 text-xs text-muted font-body leading-normal">
            Long-form essays, deep dives &amp; newsletter issues.
          </p>
        </div>
        <div class="mt-4 pt-2 border-t border-line/50 flex items-center gap-1 font-mono text-xs font-semibold text-ink group-hover:text-accent">
          <span>Follow @kunalsuri &rarr;</span>
        </div>
      </a>

      {/* LinkedIn Card */}
      <a
        href={NEWSLETTER.linkedinUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group relative flex flex-col justify-between rounded-xl border border-line bg-canvas p-4 transition-all duration-200 hover:-translate-y-0.5 hover:border-accent hover:shadow-md"
      >
        <div>
          <div class="flex items-center justify-between mb-2">
            <span class="inline-flex items-center gap-1.5 rounded-md bg-accent/10 px-2 py-0.5 font-mono text-[10px] font-semibold text-accent uppercase tracking-wider">
              Network
            </span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-muted transition-transform group-hover:translate-x-0.5 group-hover:text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </div>
          <div class="flex items-center gap-2.5 mt-1">
            {/* LinkedIn Logo SVG — kept monochrome to match the site's restrained mark treatment. */}
            <svg class="h-5 w-5 fill-muted shrink-0 transition-colors group-hover:fill-accent" viewBox="0 0 24 24" role="img" aria-label="LinkedIn">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
            </svg>
            <span class="font-display font-bold text-ink group-hover:text-accent transition-colors">
              LinkedIn
            </span>
          </div>
          <p class="mt-1 text-xs text-muted font-body leading-normal">
            Short engineering notes, thoughts &amp; tech posts.
          </p>
        </div>
        <div class="mt-4 pt-2 border-t border-line/50 flex items-center gap-1 font-mono text-xs font-semibold text-ink group-hover:text-accent">
          <span>Connect / kunalsuri &rarr;</span>
        </div>
      </a>
    </div>

    {/* Footer RSS link pill */}
    <div class="flex items-center justify-between pt-2 border-t border-line/60 text-xs font-mono text-muted">
      <span class="hidden sm:inline">Prefer RSS feed readers?</span>
      <a
        href={NEWSLETTER.rssUrl}
        class="inline-flex items-center gap-1.5 hover:text-accent transition-colors font-semibold"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 11a9 9 0 0 1 9 9"></path>
          <path d="M4 4a16 16 0 0 1 16 16"></path>
          <circle cx="5" cy="19" r="1"></circle>
        </svg>
        <span>Subscribe via RSS Feed (/rss.xml)</span>
      </a>
    </div>
  </div>
</div>
