---
import type { SeriesContext } from '../utils/series';

interface Props {
  context: SeriesContext;
}

const { context } = Astro.props;
const { name, slug, position, total, entries, prev, next } = context;
---

<!--
  The in-article series box. It renders twice per post: once above the body as
  an orientation header ("you are here"), and once below it as onward
  navigation. `data-pagefind-ignore` keeps the sibling titles out of the search
  index, so a series post is only found by its own words.
-->
<aside
  class="my-8 rounded-xl border border-line bg-surface/40 p-5"
  data-pagefind-ignore
  aria-label={`${name} series navigation`}
>
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <p class="eyebrow font-bold">
      <a href={`/series/${slug}`} class="transition-colors hover:text-accent">{name}</a>
    </p>
    <p class="font-mono text-xs text-muted">Part {position} of {total}</p>
  </div>

  <ol class="mt-3 space-y-1.5 font-display text-sm">
    {
      entries.map((entry, index) => (
        <li class="flex gap-2.5">
          <span
            class:list={[
              'font-mono text-xs shrink-0 pt-0.5',
              entry.isCurrent ? 'text-accent' : 'text-muted',
            ]}
            aria-hidden="true"
          >
            {String(index + 1).padStart(2, '0')}
          </span>
          {entry.isCurrent ? (
            <span class="font-semibold text-ink" aria-current="page">
              {entry.title}
            </span>
          ) : (
            <a
              href={`/blog/${entry.id}/`}
              class="text-muted transition-colors hover:text-accent hover:underline"
            >
              {entry.title}
            </a>
          )}
        </li>
      ))
    }
  </ol>

  {
    (prev || next) && (
      <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-line/60 pt-3 font-mono text-xs">
        {prev ? (
          <a href={`/blog/${prev.id}/`} class="text-accent transition-colors hover:text-ink">
            &larr; {prev.title}
          </a>
        ) : (
          <span />
        )}
        {next ? (
          <a href={`/blog/${next.id}/`} class="text-accent transition-colors hover:text-ink">
            {next.title} &rarr;
          </a>
        ) : (
          <span />
        )}
      </div>
    )
  }
</aside>
